# Build the judgehost's language toolchains with Nix in their own stage.
# Nix's official installer refuses to set up a working single-user install
# as root ("the group 'nixbld' specified in 'build-users-group' does not
# exist"), which is what the later Ubuntu-based stage would be. The nixos/nix
# image already has a correctly configured Nix as root, so build there and
# copy the plain output files into the Ubuntu stage instead of trying to
# install Nix itself into it.
FROM nixos/nix:2.35.2 AS nix-toolchains
COPY flake.nix flake.lock /flake/
RUN mkdir -p /toolchains \
	&& for pkg in gcc openjdk21 pypy3 kotlin ghc fpc; do \
		out=$(nix --extra-experimental-features 'nix-command flakes' build --print-out-paths --no-link "/flake#${pkg}") \
		&& nix-store --query --requisites "$out" | xargs cp -a --parents --target-directory=/toolchains \
		&& echo "$out" >> /toolchains-outputs.txt; \
	done

FROM ubuntu:24.04
LABEL org.opencontainers.image.authors="DOMjudge team <team@domjudge.org>"

ENV DEBIAN_FRONTEND=noninteractive

COPY docker-nix/judgehost/add_repositories.sh /scripts/add_repositories.sh

# Install required packages for build of judgehost
RUN apt-get update \
	&& apt-get install --no-install-recommends --no-install-suggests -y \
	autoconf automake git pkg-config \
	gcc g++ make zip unzip \
	php-cli php-zip lsb-release debootstrap \
	php-gd php-curl php-mysql php-json \
	php-gmp php-xml php-bcmath php-mbstring \
	sudo bsdmainutils ntp libcgroup-dev procps \
	libcurl4-gnutls-dev libjsoncpp-dev libmagic-dev \
	ca-certificates \
	&& rm -rf /var/lib/apt/lists/*

# Set up user
RUN useradd -m domjudge

# Install composer

RUN php -r "copy('https://getcomposer.org/installer', 'composer-setup.php');" \
	&& php composer-setup.php \
	&& mv /composer.phar /usr/local/bin/composer

# Pre-built Nix closure for the chroot's language toolchains (see the
# nix-toolchains stage above) - baked in at image build time, so
# install-nix-toolchains.sh only has to copy plain files into the chroot at
# container run time. No Nix install/daemon is needed in this image at all.
COPY --from=nix-toolchains /toolchains /nix-toolchains
COPY --from=nix-toolchains /toolchains-outputs.txt /nix-toolchains-outputs.txt

# Add DOMjudge source code and build script
ADD domjudge.tar.gz /domjudge-src
ADD docker-nix/judgehost/build.sh /domjudge-src

# Apply patches
COPY docker-nix/judgehost/scripts/patches.sh /scripts/patches.sh
COPY docker-nix/judgehost/scripts/patches.d /scripts/patches.d
COPY docker-nix/judgehost/scripts/multipass.patch /scripts/multipass.patch
RUN chmod 700 /scripts/patches.sh && /scripts/patches.sh

# Build and install judgehost
RUN /domjudge-src/build.sh

# We need to mount proc, which is not possible in "docker build". Thus we need to run this when starting the container
COPY ["docker-nix/judgehost/chroot-and-tar.sh", "docker-nix/judgehost/install-nix-toolchains.sh", "/scripts/"]
CMD ["/scripts/chroot-and-tar.sh"]
